# nginx config template — rendered by entrypoint.sh (placeholders: __PORT__, __WS_PATH__, __SUB_PATH__)
# Render terminates TLS on *.onrender.com and forwards plain HTTP to this port.
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
worker_processes 1;

events {
    worker_connections 256;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;

    client_body_temp_path /tmp/nginx-client-body;
    proxy_temp_path       /tmp/nginx-proxy;
    fastcgi_temp_path     /tmp/nginx-fastcgi;
    uwsgi_temp_path       /tmp/nginx-uwsgi;
    scgi_temp_path        /tmp/nginx-scgi;

    server {
        listen 0.0.0.0:__PORT__;
        server_name _;

        # Subscription file (exact path only, no listing, no caching)
        location = /__SUB_PATH__ {
            alias /app/subscription.txt;
            default_type text/plain;
            add_header Cache-Control "no-store";
        }

        # xray WebSocket inbound -> 127.0.0.1:10001
        location /__WS_PATH__ {
            proxy_pass http://127.0.0.1:10001;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_buffering off;
        }

        # Everything else: plain static placeholder site (disguise)
        location / {
            root /usr/share/nginx/html;
            index index.html;
            try_files $uri $uri/ /index.html;
        }
    }
}
